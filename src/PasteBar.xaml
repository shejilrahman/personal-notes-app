<!-- Floating panel shown while "paste one by one" is running. Always dark, like a media overlay. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Margin="22" Width="400"
      TextElement.FontFamily="{StaticResource UiFont}"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True">

    <Grid.Resources>
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Foreground" Value="#E8EAEE"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="back" CornerRadius="9" Background="#2B2F39"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0,12,1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Background" Value="#3A3F4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <Border CornerRadius="16" Background="#15171C">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="#15171C" BorderBrush="#2C303A" BorderThickness="1" Padding="16,14,16,14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="Header" Grid.Column="1" Margin="11,0,0,1" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="#F3F4F7" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Counter" Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#8E96A6"/>
            </Grid>

            <StackPanel x:Name="Details">
                <TextBlock x:Name="Preview" Margin="0,11,0,0" FontSize="12.5" Foreground="#B4BAC6" TextTrimming="CharacterEllipsis"/>

                <!-- progress -->
                <Grid Height="4" Margin="0,12,0,0">
                    <Border CornerRadius="2" Background="#2B2F39"/>
                    <Border x:Name="Progress" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentGradient}"/>
                </Grid>

                <Grid Margin="0,13,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BackButton" Style="{StaticResource BarButton}" Content="Back"/>
                        <Button x:Name="SkipButton" Style="{StaticResource BarButton}" Content="Skip" Margin="6,0,0,0"/>
                        <Button x:Name="StopButton" Style="{StaticResource BarButton}" Content="Stop" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border CornerRadius="5" Padding="6,2" Background="#2B2F39">
                            <TextBlock Text="Ctrl+V" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="#C9CED8"/>
                        </Border>
                        <TextBlock Text="pastes it" Margin="7,0,0,1" FontSize="11.5" VerticalAlignment="Center" Foreground="#8E96A6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Grid>
