<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root"
      Background="{DynamicResource BgEditor}"
      TextElement.FontFamily="{StaticResource UiFont}"
      TextElement.Foreground="{DynamicResource Text}"
      TextOptions.TextFormattingMode="Display"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="304"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================================================================ Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Brand -->
            <StackPanel Orientation="Horizontal" Margin="20,18,20,16">
                <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Personal Notes" FontFamily="{StaticResource DisplayFont}" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CountText" Text="" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Faint}"/>
                </StackPanel>
            </StackPanel>

            <!-- New note -->
            <Button x:Name="NewButton" Grid.Row="1" Style="{StaticResource AccentButton}" Margin="16,0,16,12" ToolTip="New note (Ctrl+N)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="New note" Margin="9,0,0,1" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Search -->
            <TextBox x:Name="SearchBox" Grid.Row="2" Style="{StaticResource SearchBox}" Margin="16,0,16,10" Tag="Search by note name or details"/>

            <!-- All / Favourites -->
            <Border Grid.Row="3" Margin="16,0,16,10" Padding="3" CornerRadius="11" Background="{DynamicResource SegmentBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="AllTab" Grid.Column="0" Style="{StaticResource Segment}" GroupName="NoteFilter" IsChecked="True" Content="All notes"/>
                    <RadioButton x:Name="FavTab" Grid.Column="1" Style="{StaticResource Segment}" GroupName="NoteFilter" ToolTip="Pick from your favourite notes by name">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Gold}"/>
                            <TextBlock x:Name="FavTabText" Text="Favourites" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            <!-- Notes -->
            <ListBox x:Name="NotesList" Grid.Row="4" Style="{StaticResource NoteList}" Margin="0,0,0,10"/>
            <StackPanel x:Name="EmptyState" Grid.Row="4" Margin="28,36,28,0" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="EmptyIcon" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Faint}"/>
                <TextBlock x:Name="EmptyTitle" Text="" FontSize="13.5" FontWeight="SemiBold" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="EmptyText" Text="" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
        </Grid>
    </Border>

    <!-- ================================================================= Editor -->
    <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top strip: pinned hint, theme, shortcuts -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,14,0">
            <Border CornerRadius="9" Height="28" Padding="10,0,12,0" Margin="0,0,8,0" VerticalAlignment="Center" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    ToolTip="This window stays above all other windows until you press Ctrl+Shift+A">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource AccentSolid}"/>
                    <TextBlock Text="Pinned on top" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                    <TextBlock Text="Ctrl+Shift+A" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Faint}"/>
                </StackPanel>
            </Border>
            <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="&#xE706;" ToolTip="Switch between dark and light"/>
            <Button x:Name="EyeButton" Style="{StaticResource IconButton}" Content="&#xE7B3;" ToolTip="Keyboard shortcuts (F1)"/>
        </StackPanel>

        <!-- Note name -->
        <Grid Grid.Row="1" Margin="38,10,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox" Style="{StaticResource PlainBox}" Tag="Note name" MaxLength="80"
                     FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"
                     ToolTip="The note's name. Click to rename it."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Button x:Name="FavButton" Style="{StaticResource IconButton}" Content="&#xE734;" ToolTip="Add to favourites (Ctrl+D)"/>
                <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Move to the Recycle Bin"/>
            </StackPanel>
        </Grid>

        <!-- Where and when -->
        <TextBlock x:Name="MetaText" Grid.Row="2" Margin="40,6,24,0" FontSize="12" Foreground="{DynamicResource Faint}" TextTrimming="CharacterEllipsis"/>

        <!-- Details: always editable. Parts saved as [[text]] are drawn as cards inside the text. -->
        <RichTextBox x:Name="BodyBox" Grid.Row="3" Style="{StaticResource PlainRich}" Margin="38,18,6,0" FontSize="14.5"
                     AcceptsTab="True" IsDocumentEnabled="True" AllowDrop="False" VerticalScrollBarVisibility="Auto">
            <RichTextBox.Resources>
                <!-- every line the same height, tall enough for a card -->
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="LineHeight" Value="28"/>
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                </Style>
            </RichTextBox.Resources>
            <FlowDocument PagePadding="2,0,14,14"/>
        </RichTextBox>
        <TextBlock x:Name="BodyHint" Grid.Row="3" Margin="42,22,24,0" VerticalAlignment="Top" FontSize="14.5" IsHitTestVisible="False"
                   Foreground="{DynamicResource Faint}" Text="Write the details here…"/>

        <!-- Action dock -->
        <Grid Grid.Row="4" Margin="22,12,22,18">
            <Border CornerRadius="15" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.16" Color="Black"/>
                </Border.Effect>
            </Border>
            <Grid Margin="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CardButton" Grid.Column="2" Style="{StaticResource PillButton}" Margin="4,0,0,0"
                        ToolTip="Turn the selected text into a card you can click to copy (Ctrl+Q). Use it again on a card to undo.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource AccentSolid}"/>
                        <TextBlock Text="Make card" Margin="9,0,0,1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MicButton" Style="{StaticResource PillButton}" ToolTip="Type with your voice (Ctrl+M or Win+H)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="MicIcon" Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MicLabel" Text="Dictate" Margin="9,0,0,1" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="PasteButton" Grid.Column="1" Style="{StaticResource PillButton}" Margin="4,0,0,0" ToolTip="Paste several notes or lines into another program, one per Ctrl+V">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Paste one by one" Margin="9,0,0,1" VerticalAlignment="Center"/>
                        <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="9,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Faint}"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,10,0">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource Faint}"/>
                    <TextBlock x:Name="StatusText" FontSize="12" Margin="8,0,0,1" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>

    <!-- ================================================================= Popups -->

    <!-- Paste one by one: what to queue -->
    <Popup x:Name="PastePopup" AllowsTransparency="True" StaysOpen="False" Placement="Top" PopupAnimation="Fade" VerticalOffset="-2" HorizontalOffset="-18">
        <Grid Margin="18">
            <Border CornerRadius="14" Background="{DynamicResource Card}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="14" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="6"
                    TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{DynamicResource Text}" TextOptions.TextFormattingMode="Display">
                <StackPanel x:Name="PasteItems" MinWidth="290"/>
            </Border>
        </Grid>
    </Popup>

    <!-- Keyboard shortcuts -->
    <Popup x:Name="ShortcutsPopup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom" PopupAnimation="Fade" VerticalOffset="-8" HorizontalOffset="-446">
        <Grid Margin="18">
            <Border CornerRadius="14" Background="{DynamicResource Card}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black"/>
                </Border.Effect>
            </Border>
            <Border Width="464" CornerRadius="14" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="20,16,20,16"
                    TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{DynamicResource Text}" TextOptions.TextFormattingMode="Display">
                <StackPanel>
                    <TextBlock Text="Keyboard shortcuts" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <StackPanel x:Name="ShortcutRows"/>
                </StackPanel>
            </Border>
        </Grid>
    </Popup>

    <!-- ================================================================= Dialog -->
    <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
        <Border Background="{DynamicResource Dim}"/>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
            <Border CornerRadius="16" Background="{DynamicResource Card}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.4" Color="Black"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="16" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24,22,24,20">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogText" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource PillButton}" BorderBrush="{DynamicResource Border}" Content="Cancel" MinWidth="86"/>
                        <Button x:Name="DialogOk" Style="{StaticResource AccentButton}" Height="36" Margin="10,0,0,0" MinWidth="96" Content="OK"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Grid>
